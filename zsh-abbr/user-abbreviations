# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------

abbr zrestart="exec $SHELL -l"
abbr zsource="source ~/.zshrc"

# ------------------------------------------------------------------------------
# Zsh configuration
# ------------------------------------------------------------------------------

abbr zshrc="vim ~/.zshrc"
abbr zshrci="vim-insiders ~/.zshrc"
abbr zalias="vim ~/.zsh.d/alias.zsh"
abbr zeval="vim ~/.zsh.d/eval.zsh"
abbr zpath="vim ~/.zsh.d/path.zsh"

# ------------------------------------------------------------------------------
# File and directory
# ------------------------------------------------------------------------------

abbr rm="rm -v"
abbr rmi="rm -iv"
abbr rmd="rm -riv"

abbr la="ls -laF"
abbr tree1="tree -L 1"
abbr tree2="tree -L 2"
abbr tree3="tree -L 3"
abbr fname="find . -name"

abbr works="cd ~/Works"
abbr dot="cd ~/Works/dotfiles"

# ------------------------------------------------------------------------------
# Editor
# ------------------------------------------------------------------------------

abbr vim="nvim"
abbr lvim="NVIM_APPNAME=lazy-vim nvim"

# ------------------------------------------------------------------------------
# Git
# ------------------------------------------------------------------------------

abbr glo="git log --oneline"
abbr glt="git log --pretty=format:'%H (%ai) %s'"

# ------------------------------------------------------------------------------
# Containers and virtual machines
# ------------------------------------------------------------------------------

# docker
abbr dcbnc="docker compose build --no-cache"
abbr dcu="docker compose up"
abbr dcud="docker compose up -d"
abbr dcd="docker compose down"

# multipass
abbr mp="multipass"
abbr mpstart="multipass start"
abbr mpshell="multipass shell"
abbr mpstop="multipass stop"

# ------------------------------------------------------------------------------
# macOS
# ------------------------------------------------------------------------------

# .DS_Store
abbr dsoff="defaults write com.apple.desktopservices DSDontWriteNetworkStores True"
abbr dson="defaults write com.apple.desktopservices DSDontWriteNetworkStores False"
abbr dsreset="defaults delete com.apple.desktopservices DSDontWriteNetworkStores"

# Spotlight
abbr spotoff="sudo mdutil -a -i off"
abbr spoton="sudo mdutil -a -i on"

# ------------------------------------------------------------------------------
# Terminal
# ------------------------------------------------------------------------------

abbr ghost="ghostty +show-config --default"
